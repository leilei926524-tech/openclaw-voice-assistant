# OpenClaw Voice Assistant Configuration
# Copy this file to .env and fill in your credentials

# ============================================
# Xiaomi Smart Speaker Settings
# ============================================

# Your Xiaomi account username (phone number or email)
XIAOMI_USERNAME=your_xiaomi_username_here

# Your Xiaomi account password
XIAOMI_PASSWORD=your_xiaomi_password_here

# Device ID of your Xiao Ai speaker
# Run scripts/discover_devices.py to find this
XIAOMI_DEVICE_ID=your_device_id_here

# Xiaomi service ID (usually "micoapi")
XIAOMI_SID=micoapi

# ============================================
# Samantha AI Companion Settings
# ============================================

# Directory for Samantha's data storage
SAMANTHA_DATA_DIR=./data

# Directory for personality seed files
SAMANTHA_PERSONALITY_SEEDS=./assets/personality_seeds

# Relationship database file
SAMANTHA_DB_FILE=${SAMANTHA_DATA_DIR}/relationship.db

# ============================================
# Voice Assistant Settings
# ============================================

# Minimum text length to speak (characters)
VOICE_MIN_LENGTH=10

# Maximum text length to speak (characters)
VOICE_MAX_LENGTH=300

# Enable/disable voice by default
VOICE_ENABLED=true

# Voice speaking speed (1.0 = normal)
VOICE_SPEED=1.0

# ============================================
# Application Settings
# ============================================

# Debug mode (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Language for TTS (zh-CN, en-US, etc.)
TTS_LANGUAGE=zh-CN

# ============================================
# Optional: Advanced Settings
# ============================================

# API timeout in seconds
API_TIMEOUT=30

# Retry attempts for failed API calls
API_RETRIES=3

# Heartbeat check interval in hours
HEARTBEAT_INTERVAL_HOURS=2

# Location awareness (true/false)
LOCATION_AWARE=false

# MBTI coaching (true/false)
MBTI_COACHING=false

# ============================================
# Security Notes
# ============================================

# NEVER commit .env file to version control!
# Add .env to your .gitignore file
# Use environment variables in production
# Rotate credentials regularly